{
  "name": "osg-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Real-binary Windows journeys driven through tauri-driver and the actual WebView.",
  "type": "module",
  "scripts": {
    "$comment": "run-isolated.mjs discovers or accepts journeys, then launches one fresh WDIO process per spec. The config therefore creates a distinct database/WebView root before each application spawn; adding a journey cannot silently omit it from the default suite.",
    "test": "node --test run-isolated.test.mjs && node run-isolated.mjs journeys/startup.journey.js journeys/defaultFont.journey.js",
    "test:damaged-font": "node scenarios/damagedFontPayload.mjs",
    "test:all": "node --test run-isolated.test.mjs && node run-isolated.mjs",
    "test:workflows": "node run-isolated.mjs journeys/urlToPreview.journey.js journeys/editPersistRelaunch.journey.js journeys/unicodeCues.journey.js",
    "test:download": "node run-isolated.mjs journeys/urlToPreview.journey.js",
    "test:persistence": "node run-isolated.mjs journeys/editPersistRelaunch.journey.js",
    "test:unicode": "node run-isolated.mjs journeys/unicodeCues.journey.js",
    "test:export": "node run-isolated.mjs journeys/nativeExportDecoded.journey.js",
    "stress:persistence": "node run-isolated.mjs --repeat 8 journeys/editPersistRelaunch.journey.js",
    "recon": "wdio run wdio.conf.js --spec ./journeys/reconnaissance.journey.js",
    "probe:restore": "wdio run wdio.conf.js --spec ./journeys/restoreProbe.journey.js"
  },
  "devDependencies": {
    "@wdio/cli": "9.20.0",
    "@wdio/local-runner": "9.20.0",
    "@wdio/mocha-framework": "9.20.0",
    "@wdio/spec-reporter": "9.20.0",
    "@wdio/tauri-service": "1.3.0",
    "webdriverio": "9.20.0"
  }
}
