{
  "name": "osg-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Real-binary Windows journeys driven through tauri-driver and the actual WebView.",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.js --spec ./journeys/startup.journey.js --spec ./journeys/defaultFont.journey.js",
    "test:damaged-font": "node scenarios/damagedFontPayload.mjs",
    "test:workflows": "wdio run wdio.conf.js --spec ./journeys/urlToPreview.journey.js --spec ./journeys/editPersistRelaunch.journey.js --spec ./journeys/unicodeCues.journey.js",
    "test:download": "wdio run wdio.conf.js --spec ./journeys/urlToPreview.journey.js",
    "recon": "wdio run wdio.conf.js --spec ./journeys/reconnaissance.journey.js",
    "probe:restore": "wdio run wdio.conf.js --spec ./journeys/restoreProbe.journey.js"
  },
  "devDependencies": {
    "@wdio/cli": "9.20.0",
    "@wdio/local-runner": "9.20.0",
    "@wdio/mocha-framework": "9.20.0",
    "@wdio/spec-reporter": "9.20.0",
    "@wdio/tauri-service": "1.3.0",
    "webdriverio": "9.20.0"
  }
}
