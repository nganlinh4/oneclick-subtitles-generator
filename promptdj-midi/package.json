{
  "name": "promptdj-midi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check:visual-contract": "node scripts/check-visual-contract.mjs",
    "test:visual-contract": "node --test scripts/check-visual-contract.test.mjs",
    "update:visual-contract": "node scripts/check-visual-contract.mjs --update --baseline-ref HEAD",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.8.3",
    "vite": "8.0.16"
  }
}
