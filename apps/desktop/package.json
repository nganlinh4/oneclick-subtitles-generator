{
  "name": "@osg/desktop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev:vite": "npm --prefix ../.. run dev:vite",
    "dev:vite:inner": "npm --prefix ../.. run dev:vite:inner",
    "build:frontend": "npm --prefix ../.. run build:frontend",
    "build:frontend:inner": "npm --prefix ../.. run build:frontend:inner",
    "tauri": "node ../../scripts/run-tauri-cli.js",
    "tauri:build": "node ../../scripts/run-tauri-cli.js build --features production",
    "tauri:dev": "node ../../scripts/run-tauri-cli.js dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
