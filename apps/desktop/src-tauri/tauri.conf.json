{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One-Click Subtitles Generator",
  "version": "1.0.0",
  "identifier": "io.github.nganlinh4.oneclicksubtitles",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:3030",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../../../build",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "One-Click Subtitles Generator",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "maximized": true,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#1a1a1a",
        "dragDropEnabled": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:3030",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:3030 ws://127.0.0.1:3030",
        "font-src": "'self' data: https://fonts.gstatic.com http://127.0.0.1:3030",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "object-src": "'none'",
        "script-src": "'self' http://127.0.0.1:3030",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com http://127.0.0.1:3030"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Create, edit, translate, and render subtitles",
    "resources": {
      "../../../crates/osg-asr/worker/osg_asr_worker.py": "workers/osg_asr_worker.py",
      "../../../crates/osg-speech/worker/osg_speech_worker.py": "workers/osg_speech_worker.py",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "resources/ui-fonts/019201394f5f7edd355567b138dddb4fd21d414696ff0582058ec11d2d5963c4": "ui-fonts/019201394f5f7edd355567b138dddb4fd21d414696ff0582058ec11d2d5963c4",
      "resources/ui-fonts/0f63b3ae4c60341fc1348749796505e9ab621a3ab690b80f9cdf66dafc1eca19": "ui-fonts/0f63b3ae4c60341fc1348749796505e9ab621a3ab690b80f9cdf66dafc1eca19",
      "resources/ui-fonts/1d361a8f8e8ce6e68457dcd93fb56e162e6baa3bbb7e7573a290d44399f6b57e": "ui-fonts/1d361a8f8e8ce6e68457dcd93fb56e162e6baa3bbb7e7573a290d44399f6b57e",
      "resources/ui-fonts/3215351d7b5587396710ab80bd31994ebbf3a9ee6f8e67b3c29a30d909cec55f": "ui-fonts/3215351d7b5587396710ab80bd31994ebbf3a9ee6f8e67b3c29a30d909cec55f",
      "resources/ui-fonts/7343aefa9061998bdfea8c1e2aa6943a029218dd78a23e5fde441e832fe66629": "ui-fonts/7343aefa9061998bdfea8c1e2aa6943a029218dd78a23e5fde441e832fe66629",
      "resources/ui-fonts/9d59f14b9ce636f160dc7398046985fca567cd8add6b9f84f79cd2b5a9bb3dcd": "ui-fonts/9d59f14b9ce636f160dc7398046985fca567cd8add6b9f84f79cd2b5a9bb3dcd",
      "resources/ui-fonts/b7bcc5489391e48d44f4238b5e2eae87ddeb8269073853c904d947a173e33b40": "ui-fonts/b7bcc5489391e48d44f4238b5e2eae87ddeb8269073853c904d947a173e33b40"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nganlinh4/oneclick-subtitles-generator/releases/latest/download/osg-desktop-updater-v2.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRTVDN0IzRTAwNzgzNTgKUldSWWd3ZmdzOGZsRUo1ME1YSXR1eWFXWGg2MzQxdTJ0Z3BtY2lFSW5GOVc3YnlGY0YvTkx2eXUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
