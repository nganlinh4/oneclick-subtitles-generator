{
  "name": "subtitles-generator",
  "version": "2.0.0",
  "description": "A subtitle generator application using Gemini AI",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "promptdj-midi",
    "video-renderer"
  ],
  "scripts": {
    "start": "npm run tauri:dev",
    "dev": "npm run tauri:dev",
    "build:promptdj": "npm run --workspace=promptdj-midi build",
    "dev:vite": "npm run generate:version && npm run build:promptdj && vite --config vite.config.mjs",
    "build:vite": "npm run build:promptdj && vite build --config vite.config.mjs",
    "tauri": "npm --prefix apps/desktop run tauri --",
    "tauri:dev": "npm --prefix apps/desktop run tauri -- dev",
    "tauri:build": "npm --prefix apps/desktop run tauri -- build",
    "build": "npm run tauri:build",
    "build:frontend": "npm run generate:version && npm run build:vite",
    "generate:version": "node scripts/generate-version.js",
    "lint": "eslint src vite.config.mjs vitest.config.mjs --max-warnings=0",
    "lint:native": "eslint src/platform src/components/lyrics/useNarrationTimelineData.js src/components/lyrics/NarrationLaneControls.js src/components/VideoRenderingSection/useNarration.js vite.config.mjs vitest.config.mjs --max-warnings=0",
    "test": "vitest run",
    "test:gemini-catalog": "node scripts/verify-gemini-catalog.js",
    "test:frontend-env": "node --test scripts/vite-public-env.test.mjs",
    "test:frozen-css": "node --test scripts/frozen-css-compatibility.test.mjs scripts/check-frozen-css-output.test.mjs",
    "test:production-transport": "node --test scripts/check-production-transport.test.js scripts/frontend-bundle-boundary.test.mjs scripts/remotion-desktop-boundary.test.mjs",
    "test:asr-worker": "python -I -B scripts/test-asr-worker.py -v",
    "test:speech-worker": "python -I -B crates/osg-speech/tests/python_worker_contract.py -v",
    "test:python-workers": "npm run test:asr-worker && npm run test:speech-worker",
    "check:i18n": "node scripts/check-i18n.js",
    "check:dependencies": "npm ls --all && npm --prefix apps/desktop ls --all",
    "check:versions": "node scripts/check-version-consistency.js",
    "check:tauri-contract": "node scripts/check-tauri-command-contract.js",
    "check:frozen-css-output": "node scripts/check-frozen-css-output.mjs",
    "check:desktop-payload-size": "node scripts/check-desktop-payload-size.mjs",
    "check:production-transport": "node scripts/check-production-transport.js",
    "test:version-consistency": "node --test scripts/check-version-consistency.test.js",
    "check:visual-freeze": "node scripts/check-visual-freeze.js && npm run --workspace=promptdj-midi check:visual-contract && npm run --workspace=video-renderer check:visual-contract",
    "test:visual-contract": "node --test scripts/check-visual-freeze.test.js promptdj-midi/scripts/check-visual-contract.test.mjs",
    "test:desktop-payload-size": "node --test scripts/check-desktop-payload-size.test.mjs",
    "check:render-visual-contract": "npm run --workspace=video-renderer check:visual-contract",
    "test:render-worker": "npm run --workspace=video-renderer test:worker",
    "update:visual-freeze": "node scripts/check-visual-freeze.js --update --baseline-ref HEAD && npm run --workspace=promptdj-midi update:visual-contract"
  },
  "dependencies": {
    "@material/web": "2.4.1",
    "@remotion/player": "4.0.507",
    "@tauri-apps/api": "2.11.1",
    "events": "^3.3.0",
    "i18next": "^23.8.0",
    "iso-639-1": "^3.1.5",
    "jszip": "^3.10.1",
    "lit": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^13.3.0",
    "react-window": "^1.8.11",
    "remotion": "4.0.507",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.0",
    "@babel/traverse": "7.29.0",
    "@babel/types": "7.29.0",
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "7zip-bin-full": "26.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "remotion": "4.0.507",
    "@remotion/bundler": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "@remotion/player": "4.0.507",
    "@remotion/renderer": "4.0.507"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
