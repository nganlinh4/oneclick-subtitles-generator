{
  "name": "subtitles-generator",
  "version": "1.0.0",
  "description": "A subtitle generator application using Gemini AI",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "promptdj-midi"
  ],
  "scripts": {
    "start": "npm run tauri:dev",
    "dev": "npm run tauri:dev",
    "build:promptdj": "node scripts/run-frontend-command.js --lane dev -- npm run build:promptdj:inner",
    "build:promptdj:inner": "node scripts/assert-frontend-context.js && npm run --workspace=promptdj-midi build:inner",
    "dev:vite": "node scripts/run-frontend-command.js --lane dev -- npm run dev:vite:inner",
    "dev:vite:inner": "node scripts/assert-frontend-context.js && npm run generate:version && npm run build:promptdj:inner && vite --config vite.config.mjs",
    "build:vite": "node scripts/run-frontend-command.js --lane dev -- npm run build:vite:inner",
    "build:vite:inner": "node scripts/assert-frontend-context.js && npm run generate:version && npm run build:promptdj:inner && vite build --config vite.config.mjs",
    "pretauri:dev": "npm run verify:managed-delivery",
    "tauri:dev": "node scripts/run-managed-command.js --lane dev -- npm --prefix apps/desktop run tauri -- dev",
    "tauri:build": "node scripts/run-managed-command.js --lane package -- npm --prefix apps/desktop run tauri:build --",
    "build": "npm run tauri:build",
    "cargo:check": "node scripts/run-managed-command.js --lane dev -- cargo check --workspace --features osg-desktop/production --locked",
    "cargo:test": "node scripts/run-managed-command.js --lane dev -- cargo test --workspace --features osg-desktop/production --locked",
    "cargo:clippy": "node scripts/run-managed-command.js --lane dev -- cargo clippy --workspace --all-targets --features osg-desktop/production --locked -- -D warnings",
    "build:frontend": "node scripts/run-frontend-command.js --lane dev -- npm run build:frontend:inner",
    "build:frontend:inner": "node scripts/assert-frontend-context.js && npm run build:vite:inner",
    "build:e2e-binary": "node scripts/build-e2e-binary.js",
    "generate:version": "node scripts/generate-version.js",
    "lint": "eslint src vite.config.mjs vitest.config.mjs --max-warnings=0",
    "lint:native": "eslint src/platform src/components/lyrics/useNarrationTimelineData.js src/components/lyrics/NarrationLaneControls.js src/components/VideoRenderingSection/useNarration.js vite.config.mjs vitest.config.mjs --max-warnings=0",
    "test": "vitest run",
    "test:gemini-catalog": "node scripts/verify-gemini-catalog.js",
    "test:frontend-env": "node --test scripts/vite-public-env.test.mjs scripts/vite-dev-freshness.test.mjs",
    "test:e2e-frontend-publication": "node --test scripts/e2e-build-metadata.test.js scripts/e2e-frontend-snapshot.test.js scripts/build-e2e-frontend.test.js",
    "test:e2e-build-publication": "node --test scripts/e2e-build-metadata.test.js scripts/e2e-frontend-snapshot.test.js scripts/build-e2e-frontend.test.js scripts/e2e-application-publication.test.js scripts/build-e2e-binary.test.js",
    "cache:status": "pwsh -NoProfile -NonInteractive -File scripts/dev-cache.ps1 -Action Status",
    "cache:prune": "pwsh -NoProfile -NonInteractive -File scripts/dev-cache.ps1 -Action Prune -ProtectUnit apps-e2e",
    "cache:prune:apply": "pwsh -NoProfile -NonInteractive -File scripts/dev-cache.ps1 -Action Prune -ProtectUnit apps-e2e -Apply -Confirm:$false",
    "test:dev-cache": "pwsh -NoProfile -NonInteractive -File scripts/dev-cache.test.ps1 && node --test scripts/managed-build-context.test.js scripts/run-frontend-command.test.js scripts/run-managed-command.test.js scripts/run-tauri-cli.test.js scripts/windows-job-supervisor.test.js scripts/windows-process-identity.test.js scripts/frontend-config-guard.test.mjs scripts/managed-frontend-output.test.mjs",
    "test:installed-local": "pwsh -NoProfile -NonInteractive -File scripts/test-installed-local.test.ps1",
    "test:frozen-css": "node --test scripts/frozen-css-compatibility.test.mjs scripts/check-frozen-css-output.test.mjs",
    "test:render-parity": "node --test scripts/render-parity-fixture.test.mjs",
    "test:parity-matrix": "node --test scripts/parity-matrix.test.mjs",
    "test:production-transport": "node --test scripts/check-production-transport.test.js scripts/frontend-bundle-boundary.test.mjs",
    "test:asr-worker": "python -I -B scripts/test-asr-worker.py -v",
    "test:speech-worker": "python -I -B crates/osg-speech/tests/python_worker_contract.py -v",
    "test:python-workers": "npm run test:asr-worker && npm run test:speech-worker",
    "check:capability-inputs": "node scripts/check-capability-inputs.js && node --test scripts/check-capability-inputs.test.js",
    "check:fixture-integrity": "node scripts/check-fixture-integrity.mjs && node --test scripts/check-fixture-integrity.test.mjs",
    "check:i18n": "node scripts/check-i18n.js",
    "check:dependencies": "node scripts/check-declared-dependencies.js && npm ls --all && npm --prefix apps/desktop ls --all",
    "check:managed-delivery": "python -I -B scripts/check-managed-delivery-contract.py",
    "verify:managed-delivery": "python -I -B scripts/check-managed-delivery-contract.py --remote",
    "test:managed-delivery": "python -I -B scripts/check-managed-delivery-contract.test.py -v && python -I -B scripts/build-provider-speech-runtime.test.py -v",
    "check:versions": "node scripts/check-version-consistency.js",
    "check:tauri-contract": "node scripts/check-tauri-command-contract.js",
    "check:frozen-css-output": "node scripts/run-frontend-command.js --lane dev -- node scripts/check-frozen-css-output.mjs",
    "check:desktop-payload-size": "node scripts/check-desktop-payload-size.mjs",
    "check:installer-payload": "node scripts/inspect-installer-payload.mjs",
    "check:production-transport": "node scripts/check-production-transport.js",
    "test:version-consistency": "node --test scripts/check-version-consistency.test.js",
    "check:visual-freeze": "node scripts/check-visual-freeze.js && npm run --workspace=promptdj-midi check:visual-contract",
    "test:visual-contract": "node --test scripts/check-visual-freeze.test.js promptdj-midi/scripts/check-visual-contract.test.mjs",
    "test:desktop-payload-size": "node --test scripts/check-desktop-payload-size.test.mjs",
    "test:installer-payload": "node --test scripts/inspect-installer-payload.test.mjs scripts/installer-payload-residue-rules.test.mjs scripts/installer-payload-extract.test.mjs scripts/read-windows-executable-metadata.test.mjs",
    "test:installed-inspector-contracts": "node --test scripts/inspect-installed-webview.test.mjs scripts/inspect-installed-media-flow.test.mjs scripts/inspect-installed-local-media-flow.test.mjs scripts/inspect-installed-native-tools.test.mjs scripts/inspect-installed-media-pipeline.test.mjs scripts/inspect-installed-editor-flow.test.mjs",
    "test:updater-fixture": "node --test scripts/derive-updater-smoke-version.test.js scripts/serve-updater-fixture.test.mjs scripts/inspect-installed-updater.test.mjs",
    "update:visual-freeze": "node scripts/check-visual-freeze.js --update --baseline-ref HEAD && npm run --workspace=promptdj-midi update:visual-contract"
  },
  "dependencies": {
    "@material/web": "2.4.1",
    "@tauri-apps/api": "2.11.1",
    "events": "^3.3.0",
    "i18next": "^23.8.0",
    "iso-639-1": "^3.1.5",
    "jszip": "^3.10.1",
    "lit": "3.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^13.3.0",
    "react-window": "^1.8.11",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.0",
    "@babel/traverse": "7.29.0",
    "@babel/types": "7.29.0",
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "7zip-bin-full": "26.2.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
